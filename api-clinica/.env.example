# Copie este arquivo para ".env" e ajuste. O ".env" NÃO vai para o Git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinica_veterinaria

# Chave usada para assinar o token de login (JWT).
# Troque por qualquer texto aleatório antes de usar "pra valer".
SECRET_KEY=troque-esta-chave-antes-de-usar-em-producao

# API governamental simulada
GOVERNO_URL=http://localhost:5001
