        <mxCell id="c78" value="&lt;b&gt;REGRAS&amp;nbsp;DE&amp;nbsp;INTEGRIDADE&amp;nbsp;(além&amp;nbsp;das&amp;nbsp;setas)&lt;/b&gt;&lt;br&gt;1.&amp;nbsp;ANIMAL:&amp;nbsp;a&amp;nbsp;raça&amp;nbsp;deve&amp;nbsp;pertencer&amp;nbsp;à&amp;nbsp;espécie&amp;nbsp;do&amp;nbsp;animal&amp;nbsp;→&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK&amp;nbsp;composta&amp;nbsp;(id_raca,&amp;nbsp;id_especie)&amp;nbsp;→&amp;nbsp;RACA,&amp;nbsp;ou&amp;nbsp;trigger.&lt;br&gt;2.&amp;nbsp;SRD:&amp;nbsp;cadastrar&amp;nbsp;a&amp;nbsp;raça&amp;nbsp;'Sem&amp;nbsp;Raça&amp;nbsp;Definida&amp;nbsp;(SRD)'&amp;nbsp;em&amp;nbsp;cada&amp;nbsp;espécie.&lt;br&gt;3.&amp;nbsp;VETERINARIO:&amp;nbsp;UK1&amp;nbsp;=&amp;nbsp;(crmv,&amp;nbsp;uf_crmv);&amp;nbsp;cpf&amp;nbsp;e&amp;nbsp;email&amp;nbsp;únicos.&lt;br&gt;4.&amp;nbsp;VINCULO_MICROCHIP:&amp;nbsp;numero_microchip&amp;nbsp;único;&amp;nbsp;no&amp;nbsp;máximo&amp;nbsp;1&amp;nbsp;vínculo&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ativo&amp;nbsp;por&amp;nbsp;animal;&amp;nbsp;histórico&amp;nbsp;preservado&amp;nbsp;(nunca&amp;nbsp;DELETE:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;preencher&amp;nbsp;data_desvinculacao&amp;nbsp;e&amp;nbsp;ativo&amp;nbsp;=&amp;nbsp;0).&lt;br&gt;5.&amp;nbsp;VACINA:&amp;nbsp;antirrabica&amp;nbsp;=&amp;nbsp;1&amp;nbsp;gera&amp;nbsp;registro&amp;nbsp;em&amp;nbsp;INTEGRACAO_GOVERNO.&lt;br&gt;6.&amp;nbsp;INTEGRACAO_GOVERNO:&amp;nbsp;id_vacina&amp;nbsp;só&amp;nbsp;é&amp;nbsp;usado&amp;nbsp;nas&amp;nbsp;operações&amp;nbsp;de&amp;nbsp;vacina;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;chave_idempotencia&amp;nbsp;única.&amp;nbsp;A&amp;nbsp;API&amp;nbsp;governamental&amp;nbsp;simulada&amp;nbsp;tem&amp;nbsp;banco&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;próprio:&amp;nbsp;esta&amp;nbsp;tabela&amp;nbsp;apenas&amp;nbsp;acompanha&amp;nbsp;as&amp;nbsp;operações&amp;nbsp;externas.&lt;br&gt;7.&amp;nbsp;Inativação&amp;nbsp;lógica&amp;nbsp;pelo&amp;nbsp;campo&amp;nbsp;ativo&amp;nbsp;(sem&amp;nbsp;excluir&amp;nbsp;histórico)." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1">
